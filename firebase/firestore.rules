rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Content admins. Same roles the app lets into the admin pages
    // (ProfilePage gate). The role lives on users/{uid}.role.
    function isSignedIn() {
      return request.auth != null;
    }

    function isContentAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') in ['admin', 'ministry_reviewer'];
    }

    // Members manage their own profile but can never grant themselves a
    // role: sign-up writes role '' and only the backend (Admin SDK, which
    // bypasses these rules) may set 'admin' / 'ministry_reviewer'.
    match /users/{document} {
      allow create: if request.auth.uid == document
        && request.resource.data.get('role', '') == '';
      allow read: if request.auth.uid == document;
      allow update: if request.auth.uid == document
        && request.resource.data.get('role', '')
           == resource.data.get('role', '');
      allow delete: if request.auth.uid == document;
    }

    // Kingdom Heirs Research Library and Ask Kingdom Heirs data: server
    // only (Cloud Functions use the Admin SDK). Raw manuscripts are never
    // readable or downloadable by members.
    match /researchSources/{doc} {
      allow read, write: if false;
    }
    match /researchSections/{doc} {
      allow read, write: if false;
    }
    match /askReports/{doc} {
      allow read, write: if false;
    }
    match /askLogs/{doc} {
      allow read, write: if false;
    }
    match /config/askKingdomHeirs {
      allow read, write: if false;
    }
    match /users/{uid}/askUsage/{day} {
      allow read, write: if false;
    }

    // Certificates (Pathway Certificates and the Commissioning Certificate
    // 'core-discipleship'). Issued once by the app. Member name, completion
    // date and certificate ID never change; the only allowed update raises
    // the grade (with its supporting counts and best quiz scores) after the
    // member improves a quiz score. Never deleted by the member.
    match /users/{uid}/certificates/{certId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.issuedAt == request.time
        && request.resource.data.get('completedAt', request.time)
           == request.time
        && request.resource.data.certificateId is string
        && request.resource.data.memberName is string
        && (!('grade' in request.resource.data)
            || (request.resource.data.grade is int
                && request.resource.data.grade >= 0
                && request.resource.data.grade <= 100));
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['grade', 'correctCount', 'questionCount', 'quizScores',
                     'gradeUpdatedAt'])
        && request.resource.data.grade is int
        && request.resource.data.grade <= 100
        && request.resource.data.grade > resource.data.get('grade', -1)
        && request.resource.data.gradeUpdatedAt == request.time;
      allow delete: if false;
    }

    match /pathways/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /pathways/{parent}/lessons/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /{path=**}/lessons/{document} {
      allow read: if true;
    }


    match /pathways/{parent}/quizzes/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /{path=**}/quizzes/{document} {
      allow read: if true;
    }

    // Quizzes imported by importContentCsv live at the top level.
    match /quizzes/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }


    match /dailyScripture/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /encouragements/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /announcements/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    // Private to the member who wrote them. The backend writes with the
    // Admin SDK, which bypasses these rules.
    match /reflections/{document} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
      allow delete: if false;
    }

    match /onboardingQuestions/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /assessmentQuestions/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    // Languages offered in the app (CMS-managed; see docs/languages.md).
    match /languages/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    // Shared translation cache. Members read it; the translateTexts
    // function writes it with the Admin SDK; admins review/approve here.
    match /machineTranslations/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    // Assessment questions imported from CSV (importContentCsv).
    match /assessmentItems/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    // CSV import reports. Written only by the importContentCsv function
    // (Admin SDK); content admins can read them on the Import page.
    match /importJobs/{document} {
      allow read: if isContentAdmin();
      allow write: if false;
    }
  }
}
