rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Content admins. Same roles the app lets into the admin pages
    // (ProfilePage gate). The role lives on users/{uid}.role.
    function isSignedIn() {
      return request.auth != null;
    }

    function isContentAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') in ['admin', 'ministry_reviewer'];
    }

    // Members manage their own profile but can never grant themselves a
    // role: sign-up writes role '' and only the backend (Admin SDK, which
    // bypasses these rules) may set 'admin' / 'ministry_reviewer'.
    match /users/{document} {
      allow create: if request.auth.uid == document
        && request.resource.data.get('role', '') == '';
      allow read: if request.auth.uid == document;
      allow update: if request.auth.uid == document
        && request.resource.data.get('role', '')
           == resource.data.get('role', '');
      allow delete: if request.auth.uid == document;
    }

    match /pathways/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /pathways/{parent}/lessons/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /{path=**}/lessons/{document} {
      allow read: if true;
    }


    match /pathways/{parent}/quizzes/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /{path=**}/quizzes/{document} {
      allow read: if true;
    }


    match /dailyScripture/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /encouragements/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /announcements/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    // Private to the member who wrote them. The backend writes with the
    // Admin SDK, which bypasses these rules.
    match /reflections/{document} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
      allow delete: if false;
    }

    match /onboardingQuestions/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    match /assessmentQuestions/{document} {
      allow create: if isContentAdmin();
      allow read: if true;
      allow write: if isContentAdmin();
      allow delete: if isContentAdmin();
    }

    // Languages offered in the app (CMS-managed; see docs/languages.md).
    match /languages/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    // Shared translation cache. Members read it; the translateTexts
    // function writes it with the Admin SDK; admins review/approve here.
    match /machineTranslations/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    // Assessment questions imported from CSV (importContentCsv).
    match /assessmentItems/{document} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    // CSV import reports. Written only by the importContentCsv function
    // (Admin SDK); content admins can read them on the Import page.
    match /importJobs/{document} {
      allow read: if isContentAdmin();
      allow write: if false;
    }
  }
}
